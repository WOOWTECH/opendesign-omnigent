+    async def _opencode_interrupt(self, conv_id: str) -> Response:
+        """Abort only the owned native session; persist idle after confirmation.
+
+        An abort acknowledgement is not an idle edge. Poll the native status
+        map (idle sessions may be absent), failing closed on timeout or bad data.
+        """
+        from omnigent.harnesses.opencode_native.bridge import (
+            OPENCODE_NATIVE_BRIDGE_ID_LABEL_KEY,
+            bridge_dir_for_bridge_id,
+            read_bridge_state,
+        )
+        from omnigent.harnesses.opencode_native.client import OpenCodeClient
+
+        try:
+            async with asyncio.timeout(_OPENCODE_INTERRUPT_TIMEOUT_S):
+                labels = await _session_labels_for_runner_spawn(
+                    server_client=self._server_client, session_id=conv_id
+                )
+                bridge_id = labels.get(OPENCODE_NATIVE_BRIDGE_ID_LABEL_KEY) or conv_id
+                bridge_dir = bridge_dir_for_bridge_id(bridge_id)
+                state = read_bridge_state(bridge_dir)
+                if state is None or state.session_id != conv_id:
+                    raise ValueError("OpenCode bridge does not own this session")
+                url = urlsplit(state.server_base_url)
+                if (
+                    url.scheme != "http"
+                    or not url.hostname
+                    or not ipaddress.ip_address(url.hostname).is_loopback
+                    or url.username is not None
+                    or url.password is not None
+                    or url.path not in ("", "/")
+                    or url.query
+                    or url.fragment
+                ):
+                    raise ValueError("OpenCode bridge is not a loopback server")
+                native_id = state.opencode_session_id
+                if not native_id.startswith("ses_") or any(
+                    not (char.isascii() and (char.isalnum() or char in "_-")) for char in native_id
+                ):
+                    raise ValueError("Invalid OpenCode session id")
+                async with OpenCodeClient(
+                    state.server_base_url,
+                    headers=state.auth_headers(),
+                    directory=state.workspace,
+                ) as client:
+                    await client.abort(native_id)
+                    while True:
+                        statuses = await client._request_json("GET", "/session/status")
+                        if not isinstance(statuses, dict):
+                            raise ValueError("Invalid OpenCode status map")
+                        if native_id not in statuses:
+                            break
+                        status = statuses[native_id]
+                        if not isinstance(status, dict) or status.get("type") not in (
+                            "idle",
+                            "busy",
+                            "retry",
+                        ):
+                            raise ValueError("Invalid OpenCode session status")
+                        if status["type"] == "idle":
+                            break
+                        await asyncio.sleep(_OPENCODE_INTERRUPT_POLL_S)
+
+                # A bridge reassigned while awaiting HTTP must not settle its new turn.
+                current = read_bridge_state(bridge_dir)
+                if (
+                    current is None
+                    or current.session_id != conv_id
+                    or current.opencode_session_id != native_id
+                    or current.server_base_url != state.server_base_url
+                    or current.active_message_id not in (None, state.active_message_id)
+                ):
+                    raise ValueError("OpenCode bridge changed during interrupt")
+                response = await self._server_client.post(
+                    f"/v1/sessions/{quote(conv_id, safe='')}/events",
+                    json={
+                        "type": "external_session_status",
+                        "data": {
+                            "status": "idle",
+                            "turn_outcome": "cancelled",
+                            "response_id": state.active_message_id or native_id,
+                        },
+                    },
+                )
+                response.raise_for_status()
+        except Exception as exc:  # noqa: BLE001 - never fall through to local-only cancel.
+            self._logger.warning(
+                "OpenCode native interrupt unconfirmed; session=%s error=%s",
+                conv_id,
+                type(exc).__name__,
+            )
+            return JSONResponse(
+                status_code=503,
+                content={
+                    "error": "opencode_native_interrupt_unconfirmed",
+                    "detail": "Could not confirm OpenCode stopped. Retry Stop or stop the runner.",
+                },
             )
         return Response(status_code=204)
 
