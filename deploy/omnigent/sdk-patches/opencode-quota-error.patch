+def _quota_error_code(value: object, depth: int = 0) -> str | None:
+    """Find an explicit provider quota code inside an OpenCode retry error."""
+    if depth > 5:
+        return None
+    if isinstance(value, Mapping):
+        for key in ("type", "code"):
+            if value.get(key) in ("usage_limit_reached", "insufficient_quota"):
+                return str(value[key])
+        for key in ("error", "data", "message", "responseBody"):
+            if code := _quota_error_code(value.get(key), depth + 1):
+                return code
+    elif isinstance(value, str):
+        # Gateways can wrap the provider JSON in a textual exception prefix.
+        decoder = json.JSONDecoder()
+        for index, char in enumerate(value[:16384]):
+            if char != "{":
+                continue
+            try:
+                parsed, _ = decoder.raw_decode(value[index : index + 16384])
+            except ValueError:
+                continue
+            if code := _quota_error_code(parsed, depth + 1):
+                return code
+    return None
 
 
